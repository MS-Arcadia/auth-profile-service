APP_NAME=auth-profile-service
ENV=local
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://auth_user:auth_pass@localhost:5432/arcadia_auth
SQL_ECHO=false

# Must match JWT_SECRET in infra/deploy/compose/.env — the other services verify what
# this one signs, and a mismatch is a 401 from all of them.
JWT_SECRET=local-development-jwt-secret-change-me-please
# Required claims. Without them every service on the platform rejects the token.
JWT_ISSUER=arcadia-auth
JWT_AUDIENCE=arcadia
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

REDIS_URL=redis://localhost:6379/1

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# The platform's real topics. One per producing service, not one per event — the
# handlers route on event_type because these carry many.
KAFKA_TOPIC_USER_EVENTS=user-events
KAFKA_TOPIC_WALLET_EVENTS=wallet-events
KAFKA_TOPIC_GAME_EVENTS=game-events
KAFKA_TOPIC_TRADE_EVENTS=trade-events
KAFKA_TOPIC_COMMUNITY_EVENTS=community-events
KAFKA_CONSUMER_GROUP=auth-profile-service

OUTBOX_POLL_INTERVAL_SECONDS=2.0
OUTBOX_BATCH_SIZE=50

PRESENCE_TTL_SECONDS=30

RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_REGISTER=5/minute

OTEL_EXPORTER_OTLP_ENDPOINT=
ENABLE_METRICS=true

SUPER_ADMIN_EMAIL=admin@arcadia.com
SUPER_ADMIN_PASSWORD=admin-password
SUPER_ADMIN_DISPLAY_NAME=Super Admin
