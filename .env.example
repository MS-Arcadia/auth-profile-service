APP_NAME=auth-profile-service
ENV=local
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://arcadia:arcadia@postgres:5432/auth_profile_db
SQL_ECHO=false

JWT_SECRET=CHANGE_ME_IN_PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

REDIS_URL=redis://redis:6379/0

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_USER_EVENTS=user-events
KAFKA_TOPIC_GIFT_CARD_ABUSE=gift-card-abuse-events
KAFKA_TOPIC_OWNERSHIP=ownership-events
KAFKA_TOPIC_ITEM_GRANTED=item-events
KAFKA_TOPIC_POST_REACTED=post-events
KAFKA_TOPIC_PRESENCE=presence-events
KAFKA_CONSUMER_GROUP=auth-profile-service

OUTBOX_POLL_INTERVAL_SECONDS=2.0
OUTBOX_BATCH_SIZE=50

PRESENCE_TTL_SECONDS=30

RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_REGISTER=5/minute

OTEL_EXPORTER_OTLP_ENDPOINT=
ENABLE_METRICS=true

SUPER_ADMIN_EMAIL=admin@arcadia.com
SUPER_ADMIN_PASSWORD=ChangeMe123!
SUPER_ADMIN_DISPLAY_NAME=Super Admin
